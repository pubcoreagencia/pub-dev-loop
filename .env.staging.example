# TASK-000032: Staging environment template
# Copy to .env.staging (git-ignored) and fill in real values:
# cp .env.staging.example .env.staging

# --- Database ---
DATABASE_URL=postgres://pubdevloop:<PASSWORD>@postgres:5432/pubdevloop

# --- API ---
PORT=3000

# --- Worker ---
WORKER_POLL_INTERVAL_MS=3000

# --- Provider Path: ROUTER (production) ---
AGENT_PROVIDER=9router
# AGENT_MODE=   # Not set — uses provider path

# --- 9Router Configuration ---
ROUTER_BASE_URL=http://9router:20128/v1
ROUTER_API_KEY=<STAGING-9ROUTER-API-KEY>
ROUTER_MODEL=ag/gemini-3-flash
ROUTER_TIMEOUT_MS=900000

# --- TASK-000030: Retry/Fallback ---
ROUTER_MAX_ATTEMPTS=2
ROUTER_TIMEOUT_TOTAL_MS=600000
ROUTER_TIMEOUT_PER_ATTEMPT_MS=300000
ROUTER_BACKOFF_MS=2000
# ROUTER_PROVIDER_CHAIN=router:ag/gemini-3-flash,router:gemini/gemini-3.1-flash-lite-preview

# --- TASK-000032: Crash Recovery ---
WORKER_LEASE_TIMEOUT_MS=30000
WORKER_HEARTBEAT_MS=10000
WORKER_ORPHAN_AGE_MS=86400000

# --- Git Identity ---
GIT_AUTHOR_NAME=PUB DEV LOOP Worker
GIT_AUTHOR_EMAIL=worker@pub-dev-loop.internal

# --- Finalizer (optional) ---
# TASK_TEST_COMMAND=npm test
