{
  "name": "pub-dev-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api.ts",
    "office:dev": "npm --prefix frontend run dev",
    "office:build": "npm --prefix frontend run build",
    "start": "node dist/api.js",
    "worker": "node dist/worker.js",
    "worker:health": "node dist/worker-health.js",
    "router:start": "powershell -ExecutionPolicy Bypass -File start-9router.ps1",
    "router:health": "node dist/router-health.js",
    "build": "tsc -p tsconfig.json",
    "build:cf": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:prototype": "vitest run tests/p1-ui.test.ts tests/prototype.test.ts",
    "pp:safety-gate": "npm run typecheck && npm run build && vitest run tests/p1-ui.test.ts tests/prototype.test.ts",
    "test:integration": "vitest run tests/integration/codex-hello.integration.test.ts",
    "devloop:resume": "tsx src/context/cli.ts --summary",
    "devloop:validate": "tsx src/context/cli.ts --validate",
    "devloop:checkpoint": "tsx src/context/cli.ts --checkpoint",
    "db:migrate": "tsx src/db/migrate.ts",
    "deploy:cf": "npm run pp:safety-gate && npx wrangler deploy --name pub-dev-loop-api --containers-rollout=none"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "jsdom": "^24.0.0"
  }
}
