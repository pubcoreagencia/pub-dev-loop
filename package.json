{
  "name": "pub-dev-loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api.ts",
    "start": "node dist/api.js",
    "worker": "node dist/worker.js",
    "worker:health": "node dist/worker-health.js",
    "router:health": "node dist/router-health.js",
    "build": "tsc -p tsconfig.json",
    "build:cf": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:prototype": "vitest run tests/prototype-smoke.test.ts",
    "test:integration": "vitest run tests/integration/codex-hello.integration.test.ts",
    "devloop:resume": "tsx src/context/cli.ts --summary",
    "devloop:validate": "tsx src/context/cli.ts --validate",
    "devloop:checkpoint": "tsx src/context/cli.ts --checkpoint",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260817.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
