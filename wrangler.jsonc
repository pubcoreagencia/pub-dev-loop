{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pub-dev-loop-api",
  "main": "src/api-worker.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "73070556ffde4aaea7cbbde327387f70"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKER_CONTAINER",
        "class_name": "PubDevLoopWorkerContainer"
      },
      {
        "name": "PROTOTYPE_API_CONTAINER",
        "class_name": "PubDevLoopApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PubDevLoopWorkerContainer"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PubDevLoopApiContainer"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "PubDevLoopWorkerContainer",
      "image": "./Dockerfile.worker",
      "max_instances": 1,
      "disk": {
        "size_mb": 4000
      }
    },
    {
      "class_name": "PubDevLoopApiContainer",
      "image": "./Dockerfile.worker",
      "max_instances": 1,
      "disk": {
        "size_mb": 4000
      }
    }
  ],
  "env": {
    "staging": {
      "name": "pub-dev-loop-api-staging",
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "73070556ffde4aaea7cbbde327387f70"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "WORKER_CONTAINER",
            "class_name": "PubDevLoopWorkerContainer"
          },
          {
            "name": "PROTOTYPE_API_CONTAINER",
            "class_name": "PubDevLoopApiContainer"
          }
        ]
      },
      "containers": [
        {
          "class_name": "PubDevLoopWorkerContainer",
          "image": "./Dockerfile.worker",
          "max_instances": 1,
          "disk": {
            "size_mb": 4000
          }
        },
        {
          "class_name": "PubDevLoopApiContainer",
          "image": "./Dockerfile.worker",
          "max_instances": 1,
          "disk": {
            "size_mb": 4000
          }
        }
      ]
    }
  }
}
