{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pub-dev-loop-api",
  "main": "src/cloudflare.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "73070556ffde4aaea7cbbde327387f70"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKER_CONTAINER",
        "class_name": "PubDevLoopWorkerContainer"
      },
      {
        "name": "PROTOTYPE_API_CONTAINER",
        "class_name": "PubDevLoopApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PubDevLoopWorkerContainer"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "PubDevLoopApiContainer"
      ]
    }
  ],
  "containers": [
    {
      "class_name": "PubDevLoopWorkerContainer",
      "image": "./Dockerfile.worker",
      "max_instances": 1
    }
  ],
  "vars": {
    "PRIMARY_GATEWAY": "openrouter",
    "FALLBACK_GATEWAY": "openrouter",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "OPENROUTER_MODEL": "openai/gpt-4o-mini",
    "OPENROUTER_FALLBACK_MODELS": "deepseek/deepseek-chat,qwen/qwen-2.5-coder-32b-instruct",
    "ROUTER_BASE_URL": "http://127.0.0.1:20128/v1",
    "ROUTER_MODEL": "gemini/gemini-3.7-flash",
    "AGENT_PROVIDER": "gateway",
    "PROTOTYPE_TEMPLATE_REPOSITORY": "https://github.com/pubcoreagencia/pub-dev-loop-template.git"
  },
  "env": {
    "staging": {
      "name": "pub-dev-loop-api-staging",
      "vars": {
        "PRIMARY_GATEWAY": "openrouter",
        "FALLBACK_GATEWAY": "openrouter",
        "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
        "OPENROUTER_MODEL": "openai/gpt-4o-mini",
        "OPENROUTER_FALLBACK_MODELS": "deepseek/deepseek-chat,qwen/qwen-2.5-coder-32b-instruct",
        "ROUTER_BASE_URL": "http://127.0.0.1:20128/v1",
        "ROUTER_MODEL": "gemini/gemini-3.7-flash",
        "AGENT_PROVIDER": "gateway",
        "PROTOTYPE_TEMPLATE_REPOSITORY": "https://github.com/pubcoreagencia/pub-dev-loop-template.git"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "73070556ffde4aaea7cbbde327387f70"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "WORKER_CONTAINER",
            "class_name": "PubDevLoopWorkerContainer"
          },
          {
            "name": "PROTOTYPE_API_CONTAINER",
            "class_name": "PubDevLoopApiContainer"
          }
        ]
      },
      "containers": [
        {
          "class_name": "PubDevLoopWorkerContainer",
          "image": "./Dockerfile.worker",
          "max_instances": 1
        }
      ]
    }
  }
}
