DATABASE_URL=postgres://pubdevloop:***@postgres:5432/pubdevloop
PORT=3000
WORKER_POLL_INTERVAL_MS=3000
# mock is safe for development. Set codex only after installing and authenticating the Codex CLI in the worker image.
AGENT_MODE=mock
AGENT_PROVIDER=mock
AGENT_TIMEOUT_MS=900000
# CODEX_COMMAND=codex
# ROUTER_BASE_URL=http://localhost:20128/v1
# ROUTER_API_KEY=
# ROUTER_MODEL=
# ROUTER_TIMEOUT_MS=900000
# Reference (not the secret itself) for your cloud Secret Manager's Codex credential injection.
# CODEX_AUTH_SECRET_REF=projects/example/secrets/codex-auth
# RUN_CODEX_INTEGRATION=0
# CODEX_INTEGRATION_REPOSITORY=/path/to/disposable/cloned/repository

# --- PUB Prototype ---
# Repository used as the transparent base template when the user starts from an idea.
# PROTOTYPE_TEMPLATE_REPOSITORY=https://github.com/pubcoreagencia/pub-dev-loop-template.git
# Persistent workspace root for Prototype Mode.
# PROTOTYPE_WORKSPACES_ROOT=/tmp/pub-prototype
# public = Cloudflare quick tunnel (default), local = localhost-only preview.
PROTOTYPE_PREVIEW_MODE=public
# Optional stable/public origin template. Leave empty when using Cloudflare quick tunnels.
# PROTOTYPE_PREVIEW_BASE_URL=
# Command used to run the generated app.
# PROTOTYPE_PREVIEW_COMMAND=npm
# PROTOTYPE_PREVIEW_ARGS=run dev -- --host 0.0.0.0 --port {PORT}
# PROTOTYPE_PREVIEW_STARTUP_TIMEOUT_MS=60000
# PROTOTYPE_TUNNEL_STARTUP_TIMEOUT_MS=30000
# CLOUDFLARED_COMMAND=cloudflared

# --- TASK-000032: Production Readiness ---
# TASK-000030: Retry/fallback configuration
# ROUTER_MAX_ATTEMPTS=3
# ROUTER_TIMEOUT_TOTAL_MS=600000
# ROUTER_TIMEOUT_PER_ATTEMPT_MS=300000
# ROUTER_BACKOFF_MS=1000
# ROUTER_PROVIDER_CHAIN=router:gemini-2.5-flash,router:gemini-2.0-flash

# TASK-000032: Crash recovery (lease/heartbeat)
# WORKER_LEASE_TIMEOUT_MS=30000
# WORKER_HEARTBEAT_MS=10000
# WORKER_ORPHAN_AGE_MS=86400000

# TASK-000032: Git identity (runtime config — overrides Dockerfile defaults)
# GIT_AUTHOR_NAME=PUB DEV LOOP Worker
# GIT_AUTHOR_EMAIL=worker@pub-dev-loop.internal

# TASK-000031: Execution tracing
# ROUTER_TIMEOUT_PER_ATTEMPT_MS=60000
