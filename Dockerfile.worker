FROM node:22-bookworm-slim

# Install git + system dependencies before any package install
ARG CLOUDFLARED_VERSION=2026.7.3
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git bash \
  && curl -fsSL "https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/cloudflared-linux-amd64.deb" -o /tmp/cloudflared.deb \
  && dpkg -i /tmp/cloudflared.deb \
  && rm -f /tmp/cloudflared.deb \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 10001 codex \
  && useradd --uid 10001 --gid codex --create-home --shell /bin/bash codex

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build && mkdir -p /tmp/pub-prototype && chown -R codex:codex /tmp/pub-prototype /app

# Install codex CLI (if available from official installer, optional for gateway mode)
USER codex
ENV HOME=/home/codex
ENV TMPDIR=/tmp
RUN (curl -fsSL --connect-timeout 5 --max-time 15 https://chatgpt.com/codex/install.sh | sh) || echo "Codex installer skipped"

# Switch to root for system-level config (git identity + codex symlink)
USER root
RUN codex_path="$(find /home/codex -type f -name codex -perm -u+x -print -quit 2>/dev/null || true)" \
  && if [ -n "$codex_path" ]; then ln -s "$codex_path" /usr/local/bin/codex && (codex --version || true); fi \
  && cloudflared --version

# TASK-000032 Phase 5: Git identity (belt-and-suspenders with runtime config)
RUN git config --system user.name "PUB DEV LOOP Worker" \
  && git config --system user.email "worker@pub-dev-loop.internal" \
  && git config --system init.defaultBranch main \
  && git config --system --add safe.directory '*'

USER codex
EXPOSE 3000
CMD ["npm", "run", "worker"]
