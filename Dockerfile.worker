FROM node:22-bookworm-slim

# Install git + system dependencies before any package install
ARG CLOUDFLARED_VERSION=2026.7.3
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git \
  && curl -fsSL "https://github.com/cloudflare/cloudflared/releases/download/${CLOUDFLARED_VERSION}/cloudflared-linux-amd64.deb" -o /tmp/cloudflared.deb \
  && dpkg -i /tmp/cloudflared.deb \
  && rm -f /tmp/cloudflared.deb \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 10001 codex \
  && useradd --uid 10001 --gid codex --create-home --shell /usr/sbin/nologin codex

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build && chown -R codex:codex /app

# Install codex CLI (for AGENT_MODE=codex path)
USER codex
ENV HOME=/home/codex
ENV TMPDIR=/tmp
RUN curl -fsSL https://chatgpt.com/codex/install.sh | sh

# Switch to root for system-level config (git identity + codex symlink)
USER root
RUN codex_path="$(find /home/codex -type f -name codex -perm -u+x -print -quit)" \
  && test -n "$codex_path" \
  && ln -s "$codex_path" /usr/local/bin/codex \
  && codex --version \
  && cloudflared --version

# TASK-000032 Phase 5: Git identity (belt-and-suspenders with runtime config)
RUN git config --system user.name "PUB DEV LOOP Worker" \
  && git config --system user.email "worker@pub-dev-loop.internal" \
  && git config --system init.defaultBranch main \
  && git config --system --add safe.directory '*'

USER codex
CMD ["npm", "run", "worker"]
